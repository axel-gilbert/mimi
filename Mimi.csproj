<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Mimi</AssemblyName>
    <RootNamespace>Mimi</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('assets\mimi.ico')">assets\mimi.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <Product>Mimi</Product>
    <Company>Mimi</Company>
    <Description>Des cœurs pour ta moitié</Description>
    <Copyright>Fait avec amour</Copyright>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- MediaPlayer (WPF) pour jouer plusieurs sons en même temps -->
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

</Project>
