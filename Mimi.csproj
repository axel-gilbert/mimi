<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Mimi</AssemblyName>
    <RootNamespace>Mimi</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('assets\mimi.ico')">assets\mimi.ico</ApplicationIcon>
    <Version>0.3.1</Version>
    <PlatformTarget>x64</PlatformTarget>
    <Product>Mimi</Product>
    <Company>Mimi</Company>
    <Description>Hearts for your other half</Description>
    <Copyright>Made with love</Copyright>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- MediaPlayer (WPF) pour jouer plusieurs sons en même temps -->
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <!-- JSON parsing of the GitHub Releases API (auto-update) -->
    <Reference Include="System.Runtime.Serialization" />
    <!-- DPAPI: the couple's key is stored encrypted for the current Windows user -->
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <!-- the test project lives in tests/ and is built separately -->
    <Compile Remove="tests/**" />
  </ItemGroup>

  <!-- GIPHY key embedded at build time: dotnet build -p:GiphyApiKey=... (official releases use a repository secret) -->
  <ItemGroup Condition="'$(GiphyApiKey)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GiphyApiKey</_Parameter1>
      <_Parameter2>$(GiphyApiKey)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- translations, embedded in the exe -->
    <EmbeddedResource Include="lang/*.ini" LogicalName="Mimi.lang.%(Filename).ini" />
    <None Remove="tests/**" />
  </ItemGroup>

</Project>
